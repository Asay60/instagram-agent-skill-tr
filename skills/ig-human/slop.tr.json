  "structures": [
    {
      "id": "tr-not-only",
      "regex": "(?i)\\bsadece\\b[^.!?\\n]{2,80}\\bdeğil\\b[^.!?\\n]{0,30}\\baynı zamanda\\b",
      "name": "Sadece X değil aynı zamanda Y",
      "fix": "Anlamı tek açık cümlede ver; gerekli karşılaştırmayı koru."
    },
    {
      "id": "tr-preamble",
      "regex": "(?i)\\b(?:bu videoda|bugünkü videoda)\\b",
      "name": "Uzun video girişi",
      "fix": "Somut konuya doğrudan gir."
    },
    {
      "id": "tr-bait",
      "regex": "(?i)\\b(?:kaydırmayı bırak|hemen takip et)\\w*",
      "name": "Genel dikkat çağrısı",
      "fix": "İzleyiciye somut neden ver."
    },
    {
      "id": "tr-rhetorical",
      "regex": "(?mi)^\\s*(?:sonuç|peki ya sonra|neden mi)\\s*\\?\\s*$",
      "name": "Kalıp soru satırı",
      "fix": "Gerekmiyorsa doğrudan yanıtı yaz."
    },
    {
      "id": "tr-hashtags",
      "regex": "(?:#\\w+\\s*){6,}",
      "name": "Hashtag yığını",
      "fix": "İlgili etiketleri seç; güncel platform sınırını ayrıca doğrula."
    },
    {
      "id": "tr-shouting",
      "regex": "\\b[A-ZÇĞİÖŞÜ]{3,}(?:\\s+[A-ZÇĞİÖŞÜ]{3,}){2,}\\b",
      "name": "Uzun büyük harf dizisi",
      "fix": "Vurgu amacını değerlendir; metni bağıran biçimde yazma."
    }
  ]
